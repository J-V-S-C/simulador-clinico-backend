# Apenas no servidor. Nunca inclua chaves de API na interface Next.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=sqlite:///data/clinical.db
# Exemplo de VPS única: sqlite:////var/lib/simulador/clinical.db
# PostgreSQL remoto opcional: postgresql+psycopg://USUARIO:SENHA@HOST:5432/postgres?sslmode=require
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
GEMINI_TIMEOUT_SECONDS=15
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=replace-with-a-long-unique-password

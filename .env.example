# Server only. Never put API keys in the Next.js frontend build.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=sqlite:///data/clinical.db
# Single-VPS production example: sqlite:////var/lib/simulador/clinical.db
# Optional remote Postgres: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
GEMINI_TIMEOUT_SECONDS=15
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=replace-with-a-long-unique-password
